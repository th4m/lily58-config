#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LOWER 1
#define RAISE 2
#define FPS 3
#define GEEMU 4
#define BOOK 5

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3   &kp N4    &kp N5                               &kp N6    &kp N7    &kp N8    &kp N9   &kp N0   &kp MINUS
&kp ESC   &kp Q  &kp W  &kp E    &kp R     &kp T                                &kp Y     &kp U     &kp I     &kp O    &kp P    &kp LBKT
&kp TAB   &kp A  &kp S  &kp D    &kp F     &kp G                                &kp H     &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V     &kp B     &kp NON_US_BSLH  &kp RGUI  &kp N     &kp M     &kp COMMA &kp DOT  &kp FSLH &kp NON_US_HASH
                        &kp LALT &mo LOWER &kp LCTRL &kp BSPC         &kp RET   &kp SPACE &mo RAISE &kp RALT
			>;

			sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
		};

		lower_layer {
			bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                       &trans    &trans   &trans          &trans    &trans    &trans
&kp F1     &kp F2       &kp F3        &kp F4       &kp F5       &kp F6                             &kp F7    &kp F8   &kp F9          &kp F10   &kp F11   &kp F12
&kp GRAVE  &kp EXCL     &kp AT        &kp HASH     &kp DOLLAR   &kp PRCNT                          &kp CARET &kp AMPS &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &kp NON_US_HASH
&kp PSCRN  &kp K_BACK   &kp K_FORWARD &trans       &trans       &trans       &trans     &kp PG_UP  &trans   &kp MINUS &kp KP_PLUS     &kp LBRC  &kp RBRC  &kp PIPE
                                      &trans       &trans       &trans       &kp DEL    &kp PG_DN  &trans   &trans    &kp INS
			>;

			sensor-bindings = <&inc_dec_kp DOWN UP>;
		};

		raise_layer {
			bindings = <
&to DEFAULT &to FPS &to GEEMU  &to BOOK &trans  &trans                        &trans      &trans    &trans    &trans   &trans    &trans
&kp GRAVE   &kp N1  &kp N2     &kp N3   &kp N4  &kp N5                        &kp N6      &kp N7    &kp N8    &kp N9   &kp N0    &trans
&kp F1      &kp F2  &kp F3     &kp F4   &kp F5  &kp F6                        &trans      &kp LEFT  &kp UP    &kp DOWN &kp RIGHT &trans
&kp F7      &kp F8  &kp F9     &kp F10  &kp F11 &kp F12  &kp HOME   &kp HOME  &kp KP_PLUS &kp MINUS &kp EQUAL &kp LBKT &kp RBKT  &kp BSLH
                               &trans   &trans  &trans   &kp END    &kp END   &trans      &trans    &trans
			>;

			sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
		};

        fps_layer {
    bindings = <
&kp ESC   &trans &kp F1 &kp N2   &kp N3 &kp N4                         &kp N6      &kp N7    &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB   &kp H  &kp Q  &kp W    &kp E  &kp R                          &kp Y       &kp U     &kp I     &kp O   &kp P    &kp LBKT
&kp LSHFT &kp X  &kp A  &kp S    &kp D  &kp F                          &kp H       &kp J     &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp N  &kp C    &kp V  &kp B &kp G        &to DEFAULT &kp N       &kp M     &kp COMMA &kp DOT &kp FSLH &kp NON_US_HASH
                        &kp LALT &kp T  &kp M &kp SPACE    &kp RET     &kp SPACE   &kp RALT  &kp RGUI
    >;

    sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        geemu_layer {
    bindings = <
&kp ESC   &trans &trans   &trans   &trans    &trans                           &trans      &trans    &trans    &trans  &trans   &trans
&kp TAB   &trans &trans   &kp UP   &kp E     &kp R                            &trans      &trans    &trans    &trans  &trans   &trans
&kp LSHFT &trans &kp LEFT &kp DOWN &kp RIGHT &trans                           &trans      &trans    &trans    &trans  &trans   &trans
&kp LCTRL &trans &trans   &trans   &trans    &kp D  &kp S         &to DEFAULT &trans      &trans    &trans    &trans  &trans   &trans
                          &trans   &trans    &kp X  &kp Z         &trans      &trans      &trans    &trans
    >;

    sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

		book_layer {
    bindings = <
&trans &trans &trans   &trans   &trans    &trans                           &trans      &trans    &trans    &trans  &trans   &trans
&trans &trans &trans   &trans   &trans    &trans                           &trans      &trans    &trans    &trans  &trans   &trans
&trans &trans &trans   &trans   &trans    &trans                           &trans      &trans    &trans    &trans  &trans   &trans
&trans &trans &trans   &trans   &trans    &trans &trans        &to DEFAULT &trans      &trans    &trans    &trans  &trans   &trans
                       &trans   &trans    &trans &trans        &kp LEFT    &kp RIGHT   &trans    &trans
    >;

    sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };


// END
	};
};

